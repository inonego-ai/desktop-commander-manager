{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "allowJs": true,
    "checkJs": false, "resolveJsonModule": true, "isolatedModules": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true,
    "strict": true, "noEmit": true, "types": ["svelte", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
